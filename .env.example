# Environment Configuration
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
DEBUG=True

AZURE_VISION_ENDPOINT="https://<your-resource-name>.cognitiveservices.azure.com/"
AZURE_VISION_KEY="<your-azure-vision-key>"

# Web search (https://tavily.com). Without it, web search is skipped and `veda doctor` reports it.
TAVILY_API_KEY=""

# Model profile: qwen3-0.6b | qwen3-1.7b | qwen3-4b (see config/profiles/). Leave empty for the untrimmed base config.
# A VEDA_PROFILE set in the shell overrides this line. The server logs "[config] profile=..." at startup.
VEDA_PROFILE=""
