# Environment Configuration
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
DEBUG=True

AZURE_VISION_ENDPOINT="https://<your-resource-name>.cognitiveservices.azure.com/"
AZURE_VISION_KEY="<your-azure-vision-key>"

# Web search (https://tavily.com). Without it, web search is skipped and `veda doctor` reports it.
TAVILY_API_KEY=""

# Gmail + Calendar tools. Create an OAuth client (Desktop app) in Google Cloud with the Gmail API and Google Calendar API
# enabled, put its id and secret here, then run `python scripts/google_auth.py` once: it opens a browser for consent and
# writes GOOGLE_REFRESH_TOKEN into .env for you. Without them, mail/calendar requests answer "it isn't set up".
GOOGLE_API_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""

# Model profile: qwen3-0.6b | qwen3-1.7b | qwen3-4b | router-q4 | router-q5 (see config/profiles/). Leave empty for the untrimmed base config.
# router-q4 / router-q5 are the fine-tuned 1.7B (data/router/router-Q4_K_M.gguf, router-Q5_K_M.gguf); copy that file over by hand.
# A VEDA_PROFILE set in the shell overrides this line. The server logs "[config] profile=..." at startup.
VEDA_PROFILE=""
